{
  "name": "ruang-eq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-ruang-eq",
    "test:security": "firebase emulators:exec --project demo-ruang-eq --only auth,firestore \"vitest run tests/security.integration.ts\"",
    "review:items": "node scripts/instrument-review.mjs",
    "verify:pdf": "node scripts/inspect-pdf.mjs"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "jspdf": "4.2.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@napi-rs/canvas": "1.0.9",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "15.31.0",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  }
}
